CREATE DATABASE MST1;
USE MST1;

CREATE TABLE employee(
	employee_ID INT PRIMARY KEY,
    name VARCHAR(50)  NOT NULL,
    email VARCHAR(50) UNIQUE,
    age INT CHECK (age> 18),
    department VARCHAR(10),
    salary INT DEFAULT(50000)
    );
    
